ADMIN_USERNAME=admin
UPLOAD_PASSWORD=
BREC_HTTP_BASIC_USER=admin
BREC_HTTP_BASIC_PASS=
BREC_DEFAULT_AUTO_EXTRACT=true
BREC_DEFAULT_AUTO_CATEGORY=录播姬自动提取
BREC_WEBHOOK_BASE_URL=http://app:8000
BREC_WEBHOOK_URL=http://app:8000/api/brec/webhook
BREC_WEBHOOK_SECRET=
SONG_RECOGNITION_CACHE_PATH=/app_data/song_recognition_cache.json
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_SAMPLE_DURATION_SECONDS=12
ACRCLOUD_SKIP_INTRO_SECONDS=18
ACRCLOUD_MIN_CONFIDENCE=0.68
ACRCLOUD_HIGH_CONFIDENCE=0.90
ACRCLOUD_MIN_CONFIRMATIONS=2
ACRCLOUD_MAX_SAMPLES=8
ACRCLOUD_ENERGY_SAMPLE_ENABLED=true
ACRCLOUD_ENERGY_HOP_SECONDS=4
ACRCLOUD_ENERGY_MIN_ACTIVE_RATIO=0.55
ACRCLOUD_SAMPLE_MIN_DISTANCE_SECONDS=6
ACRCLOUD_SAMPLE_FILTER=
# 首轮识别失败后的第二遍补采样（网格扫描补齐首轮没试过的位置）
ACRCLOUD_RETRY_ENABLED=true
ACRCLOUD_RETRY_MAX_SAMPLES=6
ACRCLOUD_RETRY_GRID_SECONDS=45
# 识别驱动的边界对齐：利用 ACRCloud play_offset_ms/duration_ms 把前奏/尾奏补全后重新剪辑
SONGCUT_BOUNDARY_ALIGNMENT_ENABLED=true
# 串烧拆分：长片段里有多首歌时，按指纹偏移拆成单首歌文件（未识别残余另存）
SONGCUT_MEDLEY_SPLIT_ENABLED=true
SONGCUT_ALIGNMENT_MIN_SHIFT_SECONDS=2
SONGCUT_ALIGNMENT_TOLERANCE_SECONDS=10
SONGCUT_ALIGNMENT_MAX_EXTEND_START_SECONDS=90
SONGCUT_ALIGNMENT_MAX_EXTEND_END_SECONDS=30
SONGCUT_ALIGNMENT_MAX_SHRINK_SECONDS=30
# 直播翻唱常比录音室版长（放慢/加词/即兴），终点只允许小幅收缩，避免切掉尾奏
SONGCUT_ALIGNMENT_MAX_SHRINK_END_SECONDS=10
SONGCUT_ALIGNMENT_MIN_TRACK_DURATION_SECONDS=90
SONGCUT_ALIGNMENT_MAX_TRACK_DURATION_SECONDS=1200
# 真唱判定：指纹命中的区间需有持续稳定的响亮输出（真唱≥10s连续，说话+BGM只有5-6s且波动大）
SONGCUT_MIN_SUSTAINED_ACTIVE_SECONDS=10
SONGCUT_MAX_ACTIVITY_CV=0.62
SONGCUT_MIN_ACTIVITY_RATIO=0.35
# 能量边界精修（classic 与 gpu-model 共用）：向边界外扩展静音之上的安静前奏/尾奏
SONGCUT_INTRO_SEARCH_SECONDS=30
SONGCUT_INTRO_SILENCE_SECONDS=4
SONGCUT_OUTRO_SEARCH_SECONDS=45
SONGCUT_OUTRO_SILENCE_SECONDS=4
# 歌词识别回退：指纹识别失败（伴奏翻唱）时，用 Whisper 转写人声再搜 lrclib 歌词库反查歌名
SONGCUT_LYRIC_RECOGNITION_ENABLED=true
SONGCUT_WHISPER_MODEL=medium
SONGCUT_WHISPER_DEVICE=auto
SONGCUT_WHISPER_COMPUTE_TYPE=
SONGCUT_LYRIC_MIN_MATCH=0.55
SONGCUT_LYRIC_MAX_WINDOWS=4
SONGCUT_LYRIC_WINDOW_SECONDS=45
SONGCUT_LRCLIB_BASE_URL=https://lrclib.net
# 歌词检索引擎：网易云音乐歌词搜索（支持中日、对错字容错），lrclib 作为备选
SONGCUT_NETEASE_API_BASE=https://music.163.com
# gpu-model 专属：分块重叠防截断、music 占比过滤说话+BGM 假阳性、边界精修开关
SONGCUT_INASEG_CHUNK_OVERLAP_SECONDS=90
SONGCUT_INASEG_MIN_MUSIC_RATIO=0.55
SONGCUT_BOUNDARY_REFINEMENT_ENABLED=true
BILI_UPLOAD_CONFIG_PATH=/app_data/.bili_upload_config.json
BILI_UPLOAD_COOKIE_DIR=/app_data/bili_cookies
BILI_UPLOAD_TEMP_DIR=/app_data/bili_upload_temp
SONGCUT_PANNS_WINDOW_SECONDS=10
SONGCUT_PANNS_HOP_SECONDS=2.5
SONGCUT_PANNS_BATCH_SIZE=16
SONGCUT_PANNS_SINGING_THRESHOLD=0.18
SONGCUT_PANNS_SINGING_SPEECH_RATIO=0.9
SONGCUT_DEMUCS_MODEL=htdemucs_ft
RECORDING_CLEANUP_ENABLED=true
RECORDING_CLEANUP_THRESHOLD_GB=250
RECORDING_CLEANUP_TARGET_GB=220
