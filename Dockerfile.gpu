FROM nvidia/cuda:12.3.2-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TF_CPP_MIN_LOG_LEVEL=2

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        ffmpeg \
        libsndfile1 \
        git \
        wget \
        ca-certificates \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
COPY requirements-gpu.txt /app/requirements-gpu.txt

RUN pip install --upgrade pip \
    && pip install "tensorflow[and-cuda]==2.18.0" \
    && pip install -r /app/requirements.txt -r /app/requirements-gpu.txt

RUN git clone https://github.com/lovegaoshi/inaSpeechSegmenter.git /tmp/inaSpeechSegmenter \
    && pip install /tmp/inaSpeechSegmenter -c /app/requirements-gpu.txt \
    && pip install -r /app/requirements-gpu.txt \
    && python -c "import os, pathlib, site; [os.symlink(lib, pathlib.Path('/usr/local/lib') / lib.name) for root in site.getsitepackages() for lib in ((pathlib.Path(root) / 'nvidia').glob('*/lib/*.so*') if (pathlib.Path(root) / 'nvidia').exists() else []) if not (pathlib.Path('/usr/local/lib') / lib.name).exists()]" \
    && ldconfig \
    && rm -rf /tmp/inaSpeechSegmenter

COPY . /app

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
